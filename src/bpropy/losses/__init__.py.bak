def loss_factor_focal_ce_from_marginals_factor_sizes(
    pred, target, *, data, reduction="mean", eps=1e-8, alpha=1.0, gamma=2.0
):
    inference, theta = pred
    mu = inference.mu
    device = mu.device

    strides_full = _factor_strides_from_factor_sizes(data, theta)
    total_full = int(strides_full.sum().item())

    #nv = _num_vars_from_data(data)
    try:
        nv = _num_vars_from_data(data)
    except AttributeError:
        # NMF case: mu is variable marginals => length = 2*nv
        if mu.numel() % 2 != 0:
            raise
        nv = mu.numel() // 2

    total_unary = 2 * nv

    if mu.numel() == total_full:
        strides = strides_full
        y_ss = data.y_ss.to(device=device)

    elif mu.numel() == total_unary:
        strides = torch.full((nv,), 2, device=device, dtype=torch.long)
        y_ss = data.y_ss.to(device=device)[:total_unary]

    else:
        raise ValueError(
            f"mu has length {mu.numel()} but expected full={total_full} or unary={total_unary}."
        )

    nF = int(strides.numel())
    m_idx = torch.arange(nF, device=device).repeat_interleave(strides)

    _, global_labels = torch_scatter.scatter_max(
        y_ss, m_idx, dim=0, dim_size=nF
    )
    global_labels = global_labels.to(dtype=torch.long, device=device)

    p_t = mu.clamp_min(eps)[global_labels]
    l = -alpha * ((1.0 - p_t).clamp_min(0.0) ** gamma) * p_t.log()

    if reduction == "mean":
        return l.mean()
    if reduction == "sum":
        return l.sum()
    return l


LOSS_REGISTRY: Dict[str, Callable[..., torch.Tensor]] = {
    "bce_logits": loss_bce_logits,
    "fce_logits": loss_factor_ce_from_logits_factor_sizes,
    "ffce_logits": loss_factor_focal_ce_from_logits_factor_sizes,
    "fce": loss_factor_ce_from_marginals_factor_sizes,
    "ffce": loss_factor_focal_ce_from_marginals_factor_sizes,
    # Later: "factor_ce", "focal_ce", etc.
}

