{
  "schema_version": 1,

  "slurm": {
    "job_name": "mis_n100_p0.15_var_logits_bce",
    "partition": "gpu",
    "time": "20:00:00",
    "qos": "qos_gpu-t3",
    "cpus_per_task": 8,
    "mem": "32G",
    "gpus": 1,
    "output": "slurm_output/%x_%j.out",
    "error": "slurm_output/%x_%j.err",
    "env": { "OMP_NUM_THREADS": "8" }
  },

  "run": {
    "name": "mis_n100_p0.15_var_logits_bce",
    "output_dir": "runs",
    "resume": null,
    "save_dirname": "checkpoints",
    "tags": ["mis", "var_logits", "bce"]
  },

  "seed": 0,

  "data": {
    "problem": "mis",
    "root": "datasets/problems/mis/mis_n100_p0.15",
    "split": "train",
    "val_split": "val",
    "test_split": "test",

    "feature_mode": "EB",
    "hetero": false,
    "refresh": true,

    "precompute": {
      "lbp": false,
      "nmf": false
    },

    "loader": {
      "batch_size": 1,
      "num_workers": 2,
      "prefetch": 2,
      "pin_memory": true
    }
  },

  "problem": {
    "ground_truth": {
      "solver": "kamis",
      "args": {}
    },
    "maximize": true
  },

  "model": {
    "name": "ResidualSAGEVarLogits",
    "args": { "in_dim": 26, "hidden_dim": 64, "n_layers": 4 , "use_layernorm": false},
    "init_from": null
  },

  "loss": {
    "name": "bce_logits",
    "args": {}
  },

  "train": {
    "epochs": 100,
    "steps_per_epoch": 10,
    "val_steps": 10,

    "optimizer": {
      "name": "adamw",
      "args": { "lr": 0.00001, "weight_decay": 0.0 }
    },
    "scheduler": null,
    "grad_clip_norm": 1.0,
    "amp": false,

    "early_stop": {
      "enabled": true,
      "metric": "val/gap",
      "mode": "min",
      "patience": 100,
      "min_delta": 0.0
    },

    "checkpoint": {
      "save_best": true,
      "metric": "val/gap",
      "mode": "min",
      "every_n_steps": 5000
    }
  },

  "eval": {
    "metrics": ["gap", "accuracy"],
    "every_n_steps": 5000,
    "splits": ["val", "test"]
  },

  "logging": {
    "tensorboard": true,
    "csv": true,
    "console": {
      "every_n_steps": 100
    }
  }
}

