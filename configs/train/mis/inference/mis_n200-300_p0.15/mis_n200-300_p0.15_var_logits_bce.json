{
  "schema_version": 1,

  "slurm": {
    "job_name": "mis_n200-300_p0.15_var_logits_bce",
    "partition": "gpu",
    "time": "20:00:00",
    "qos": "qos_gpu-t3",
    "cpus_per_task": 8,
    "mem": "32G",
    "gpus": 1,
    "output": "slurm_output/%x_%j.out",
    "error": "slurm_output/%x_%j.err",
    "env": { "OMP_NUM_THREADS": "8" }
  },

  "run": {
    "name": "mis_n200-300_p0.15_var_logits_bce",
    "output_dir": "runs",
    "resume": null,
    "save_dirname": "checkpoints",
    "tags": ["mis", "var_logits", "bce"]
  },

  "seed": 0,

  "data": {
    "problem": "mis",
    "root": "datasets/problems/mis/mis_n200-300_p0.15_maxdeg15",
    "split": "train",
    "val_split": "val",
    "test_split": "test",

    "feature_mode": "EB",
    "hetero": false,
    "refresh": false,

    "precompute": {
      "lbp": false,
      "nmf": false
    },

    "loader": {
      "batch_size": 8,
      "val_batch_size": 8,
      "num_workers": 2,
      "prefetch": 2,
      "pin_memory": true
    }
  },

  "problem": {
    "ground_truth": {
      "solver": "kamis",
      "args": {}
    },
    "maximize": true
  },

  "model": {
    "name": "GCNVarLogits",
    "args": { "in_dim": 54, "hidden_dim": 64, "n_layers": 4 , "dropout_p": 0.25, "norm": null},
    "init_from": "/users/schulz/bpropy-jz/runs/mis_n100_p0.15_var_logits_bce_seed0/checkpoints/best.pt" 
  },

  "loss": {
    "name": "bce_logits"
  },

  "train": {
    "method": "var_logits",
    "epochs": 100000,
    "steps_per_epoch": 100000,
    "val_steps": 100000,

    "optimizer": {
      "name": "adamw",
      "args": { "lr": 0.00001, "weight_decay": 1e-4 }
    },

    "warmup": {
	    "enabled": true ,
	    "steps": 1000 ,
	    "start_factor": 0.05 ,
	    "method": "linear"
    },

    "scheduler": {
	    "name": "cosineannealing",
	    "kwargs": {"T_max": 200, "eta_min": 1e-5}
    },

    "grad_clip_norm": 1.0,
    "amp": true,

    "early_stop": {
      "enabled": true,
      "metric": "val/gap",
      "mode": "min",
      "patience": 100,
      "min_delta": 0.0
    },

    "checkpoint": {
      "save_best": true,
      "metric": "val/gap",
      "mode": "min",
      "every_n_steps": 5000
    }
  },

  "eval": {
    "metrics": ["gap", "accuracy"],
    "every_n_steps": 5000,
    "splits": ["val", "test"]
  },

  "logging": {
    "tensorboard": true,
    "csv": true,
    "console": {
      "every_n_steps": 100
    }
  }
}

