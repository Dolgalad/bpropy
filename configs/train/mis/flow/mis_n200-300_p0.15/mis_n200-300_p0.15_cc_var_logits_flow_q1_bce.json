{
  "schema_version": 1,

  "slurm": {
    "job_name": "mis_n200-300_p0.15_cc_var_logits_flow_q1_bce",
    "time": "20:00:00",
    "cpus_per_task": 8,
    "gpus": 1,
    "output": "slurm/out/%x_%j.out",
    "error": "slurm/err/%x_%j.err",
    "env": { "OMP_NUM_THREADS": "8" }
  },

  "run": {
    "name": "mis_n200-300_p0.15_cc_var_logits_flow_q1_bce",
    "output_dir": "runs",
    "resume": null,
    "save_dirname": "checkpoints",
    "tags": ["mis", "var_logits", "bce", "flow", "q1", "cliques"]
  },

  "seed": 0,

  "flow": {
    "source_prob": 0.5,
    "num_validation_times": 5 ,
    "num_test_times": 8,
    "append_t_feature": true,
    "loss_target": "q1",
    "target_space": "logit"
  },

  "data": {
    "problem": "mis",
    "root": "datasets/problems/mis/mis_n200-300_p0.15_maxdeg15",
    "split": "train",
    "val_split": "val",
    "test_split": "test",

    "feature_mode": "CC",
    "hetero": false,
    "refresh": false,

    "precompute": {
      "lbp": false,
      "ss": false,
      "nmf": false 
    },

    "loader": {
      "batch_size": 8,
      "val_batch_size": 8,
      "num_workers": 2,
      "prefetch": 2,
      "pin_memory": true
    }
  },

  "problem": {
    "ground_truth": {
      "solver": "kamis",
      "args": {}
    },
    "maximize": true 
  },

  "model": {
    "name": "GCNVarLogits",
    "args": { "in_dim": 56, "hidden_dim": 64, "n_layers": 4},
    "init_from": null
  },

  "loss": {
    "name": "bce_logits",
    "args": {}
  },

  "train": {
    "grad_accum_steps": 4,
    "epochs": 100000,
    "steps_per_epoch": 200000,
    "val_steps": 100,
    "method": "flow_variable_logits",

    "optimizer": {
      "name": "adamw",
      "args": { "lr": 0.001, "weight_decay": 1e-4 }
    },
    "warmup": {
	    "enabled": true ,
	    "steps": 1000 ,
	    "start_factor": 0.05 ,
	    "method": "linear"
    },

    "scheduler": {
	    "name": "cosineannealing",
	    "kwargs": {"T_max": 200, "eta_min": 1e-5}
    },

    "grad_clip_norm": 1.0,
    "amp": true,

    "early_stop": {
      "enabled": true,
      "metric": "val/gap",
      "mode": "min",
      "patience": 100,
      "min_delta": 0.0001
    },

    "checkpoint": {
      "save_best": true,
      "metric": "val/gap",
      "mode": "min",
      "every_n_steps": 5000
    }
  },

  "eval": {
    "metrics": ["gap", "accuracy"],
    "every_n_steps": 5000,
    "splits": ["val", "test"]
  },

  "logging": {
    "tensorboard": true,
    "csv": true,
    "console": {
      "every_n_steps": 100
    }
  }
}

