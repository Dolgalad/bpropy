{
  "schema_version": 1,

  "slurm": {
    "job_name": "mis_n100_p0.15_lbp_fce",
    "partition": "gpu",
    "time": "20:00:00",
    "qos": "qos_gpu-t3",
    "cpus_per_task": 8,
    "mem": "32G",
    "gpus": 1,
    "output": "slurm_output/%x_%j.out",
    "error": "slurm_output/%x_%j.err",
    "env": { "OMP_NUM_THREADS": "8" }
  },

  "run": {
    "name": "mis_n100_p0.15_lbp_fce",
    "output_dir": "runs",
    "resume": null,
    "save_dirname": "checkpoints",
    "tags": ["mis", "lbp", "fce"]
  },

  "seed": 0,

  "data": {
    "problem": "mis",
    "root": "datasets/problems/mis/mis_n100_p0.15",
    "split": "train",
    "val_split": "val",
    "test_split": "test",

    "feature_mode": "EB",
    "hetero": false,
    "refresh": false,

    "precompute": {
      "lbp": true,
      "nmf": false,
      "ss": true
    },

    "loader": {
      "batch_size": 1,
      "num_workers": 2,
      "prefetch": 2,
      "pin_memory": true
    }
  },

  "problem": {
    "ground_truth": {
      "solver": "kamis",
      "args": {}
    },
    "maximize": true
  },

  "model": {
    "name": "GCN_MRF_v4",
    "args": { "in_dim": 54, "hidden_dim": 64, "n_layers": 4 , "dropout_p": 0.25, "norm": null, "inference": "loopy_belief_propagation", "bp_max_iter":10, "bp_damping": 0.5},
    "init_from": null
  },

  "loss": {
    "name": "fce",
    "args": {},
    "regularizers": [
      {
        "name": "entropy_bernoulli",
        "weight": 0.0,
        "kwargs": { "reduction": "mean", "eps": 1e-12 }
      }
    ]
  },

  "train": {
    "epochs": 100000,
    "steps_per_epoch": 500000,
    "val_steps": 200000,
    "method": "factor_marginals",

    "optimizer": {
      "name": "adamw",
      "args": { "lr": 0.001, "weight_decay": 1e-4 }
    },
    "scheduler": null,
    "grad_clip_norm": 1.0,
    "amp": false,

    "early_stop": {
      "enabled": true,
      "metric": "val/gap",
      "mode": "min",
      "patience": 1000,
      "min_delta": 0.0
    },

    "checkpoint": {
      "save_best": true,
      "metric": "val/gap",
      "mode": "min",
      "every_n_steps": 5000
    }
  },

  "eval": {
    "metrics": ["gap", "accuracy"],
    "every_n_steps": 5000,
    "splits": ["val", "test"]
  },

  "logging": {
    "tensorboard": true,
    "csv": true,
    "console": {
      "every_n_steps": 100
    }
  }
}

