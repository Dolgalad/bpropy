{
  "schema_version": 1,

  "slurm": {
    "job_name": "scp_n50_m50_k5_lbp_vce_pairwise_approx_max_transformer_to_scp_n150-300_m150-300_k15",
    "time": "20:00:00",
    "cpus_per_task": 8,
    "gpus": 1,
    "output": "slurm/out/%x_%j.out",
    "error": "slurm/err/%x_%j.err",
    "env": { "OMP_NUM_THREADS": "8" }
  },

  "run": {
    "name": "scp_n50_m50_k5_lbp_vce_pairwise_approx_max_transformer_to_scp_n150-300_m150-300_k15",
    "output_dir": "runs",
    "resume": null,
    "save_dirname": "checkpoints",
    "tags": ["scp", "lbp", "vce", "fg_approx_pairwise"]
  },

  "seed": 0,

  "data": {
    "problem": "scp",
    "root": "datasets/problems/scp/scp_n150-300_m150-300_k15_balanced",
    "split": "train",
    "val_split": "val",
    "test_split": "test",

    "feature_mode": "EB",
    "hetero": false,
    "refresh": false,

    "precompute": {
      "lbp": true,
      "ss": true,
      "nmf": false ,
      "fg_approx": {
        "method": "pairwise" ,
	"seed": 0
      }
    },

    "loader": {
      "batch_size": 2,
      "val_batch_size": 2,
      "num_workers": 2,
      "prefetch": 2,
      "pin_memory": true
    }
  },

  "problem": {
    "ground_truth": {
      "solver": "scg3",
      "args": {}
    },
    "maximize": false
  },

  "model": {
    "name": "GCN_MRF_v61_Transformer",
    "args": { "in_dim": 54, "hidden_dim": 64, "n_layers": 4, "inference": "loopy_belief_propagation", "bp_max_iter": 10, "bp_damping": 0.5 , "factor_sizes": [1,2]},
    "init_from": "/lustre/fswork/projects/rech/bnq/udj74tc/runs/scp_n50_m50_k5_lbp_vce_pairwise_approx_max_transformer_seed0/checkpoints/best.pt"
  },

  "loss": {
    "name": "vce",
    "args": {}
  },

  "train": {
    "epochs": 1,
    "steps_per_epoch": 200000,
    "val_steps": 100,
    "method": "variable_marginals",

    "optimizer": {
      "name": "adamw",
      "args": { "lr": 0.001, "weight_decay": 1e-4 }
    },

    "grad_clip_norm": 1.0,
    "amp": true,

    "early_stop": {
      "enabled": true,
      "metric": "val/gap",
      "mode": "min",
      "patience": 100,
      "min_delta": 0.0001
    },

    "checkpoint": {
      "save_best": true,
      "metric": "val/gap",
      "mode": "min",
      "every_n_steps": 5000
    }
  },

  "eval": {
    "metrics": ["gap", "accuracy"],
    "every_n_steps": 5000,
    "splits": ["val", "test"],
    "greedy_decimation": {
	    "mode": "loopy_belief_propagation",
	    "args": {"max_iter": 10, "damping": 0.5, "neg_inf": -100.0},
	    "adapter": { "pick_mode": "min_entropy", "value_mode": "argmax"}
    }
  },

  "logging": {
    "tensorboard": true,
    "csv": true,
    "console": {
      "every_n_steps": 100
    }
  }
}

