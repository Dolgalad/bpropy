{
  "schema_version": 1,

  "slurm": {
    "job_name": "scp_n120-180_m150-250_k5_pmf_default",
    "partition": "gpu",
    "time": "20:00:00",
    "qos": "qos_gpu-t3",
    "cpus_per_task": 8,
    "mem": "32G",
    "gpus": 1,
    "output": "slurm_output/%x_%j.out",
    "error": "slurm_output/%x_%j.err",
    "env": { "OMP_NUM_THREADS": "8" }
  },

  "run": {
    "name": "scp_n120-180_m150-250_k5_pmf_default",
    "output_dir": "runs",
    "resume": null,
    "save_dirname": "checkpoints",
    "tags": ["scp", "nmf", "fce"]
  },

  "seed": 0,

  "data": {
    "problem": "scp",
    "root": "datasets/problems/scp/scp_n120-180_m150-250_k5_balanced",
    "split": "train",
    "val_split": "val",
    "test_split": "test",

    "feature_mode": "EB",
    "hetero": false,
    "refresh": false,

    "precompute": {
      "lbp": false,
      "nmf": true,
      "ss": true
    },

    "loader": {
      "batch_size": 32,
      "val_batch_size": 32,

      "num_workers": 2,
      "prefetch": 2,
      "pin_memory": true
    }
  },

  "problem": {
    "ground_truth": {
      "solver": "scg3",
      "args": {}
    },
    "maximize": false
  },

  "model": {
    "name": "GCN_MRF_v4",
    "args": { "in_dim": 54, "hidden_dim": 64, "n_layers": 4 , "dropout_p": 0.25, "norm": null, "inference": "naive_mean_field", "bp_max_iter":10, "bp_damping": 0.5, "factor_sizes": [1,2,3,4,5]},
    "init_from": null
  },

  "loss": {
    "name": "fce"
  },

  "train": {
    "epochs": 100000,
    "steps_per_epoch": 500000,
    "val_steps": 200000,
    "method": "factor_marginals",

    "optimizer": {
      "name": "adamw",
      "args": { "lr": 0.001, "weight_decay": 1e-4 }
    },

    "warmup": {
	    "enabled": true ,
	    "steps": 1000 ,
	    "start_factor": 0.05 ,
	    "method": "linear"
    },

    "scheduler": {
	    "name": "cosineannealing",
	    "kwargs": {"T_max": 200, "eta_min": 1e-5}
    },

    "grad_clip_norm": 1.0,
    "amp": false,

    "early_stop": {
      "enabled": true,
      "metric": "val/gap",
      "mode": "min",
      "patience": 100,
      "min_delta": 0.0
    },

    "checkpoint": {
      "save_best": true,
      "metric": "val/gap",
      "mode": "min",
      "every_n_steps": 5000
    }
  },

  "eval": {
    "metrics": ["gap", "accuracy"],
    "every_n_steps": 5000,
    "splits": ["val", "test"]
  },

  "logging": {
    "tensorboard": true,
    "csv": true,
    "console": {
      "every_n_steps": 100
    }
  },

  "park": {
    "M": 100.0,
    "inference": "naive_mean_field",

    "add_unaries": true,
    "unary_bias": 0.0,
    "tol": 0.0,
    "bp_tol": 1e-6,
    "neg_inf": -100.0,

    "max_iter": 10,
    "damping": 0.5,

    "egg": {
      "max_iter": 10,
      "damping": 0.5
    },

    "gd": {
      "max_iter": 10,
      "damping": 0.5,
      "run_every": 1
    }
  }
}

