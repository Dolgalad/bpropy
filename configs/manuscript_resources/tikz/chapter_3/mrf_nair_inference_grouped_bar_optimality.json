{
  "figure_type": "grouped_bar",
  "title": "Average optimality gap by dataset",
  "xlabel": "Dataset",
  "ylabel": "Optimality gap (\\%)",
  "show_error_bars": false,
  "metric_scales": {
    "gap": 100.0,
    "relative_gap": 100.0
  },
  "seeds": [0, 1, 2],
  "seed_pattern": "{prefix}_seed{seed}/test_eval.json",
  "manual_legend": true,
  "legend_entries_per_row": 4,
  "legend_anchor": "$(current bounding box.south) + (0, -0.25cm)$",
  "legend_marker_width": 0.42,
  "legend_marker_height": 0.16,

  "pattern_legend_marker_width": 0.42,
  "pattern_legend_marker_height": 0.16,

  "fill_opacity": 0.55,
  "segment_draw": "black",
  "segment_line_width": "0.3pt",
  "pattern_color": "black",

  "series": [
    {"key": "pbp", "title": "PBP+EGG", "method": "entropy_greedy", "metric": "gap"     , "color": "PBPEGGColor"},
    {"key": "pbp_gd", "title": "PBP+GD", "method": "guided_decimation", "metric": "gap", "color": "PBPGDColor"},
    {"key": "pmf", "title": "PMF+EGG", "method": "entropy_greedy", "metric": "gap"     , "color": "PMFEGGColor"},
    {"key": "pmf_gd", "title": "PMF+GD", "method": "guided_decimation", "metric": "gap", "color": "PMFGDColor"},
