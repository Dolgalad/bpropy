{
  "results_dir": "test_inference_fix_and_solve",
  "gurobi_solutions_dir": "gurobi_solutions",
  "gurobi_split": "test",
  "optimal_value_key": "objective_value_from_x",
  "layout": "2x2",
  "label": "fig:inference_test_nair_gap_bar",
  "caption": "Optimality gaps for fix-and-solve inference. For each dataset, bars are grouped by fixed-variable proportion.",
  "datasets": [
    {
      "id": "scp_n50_m50_k5",
      "title": "SC-S",
      "maximize": false
    },
    {
      "id": "scp_n120-180_m150-250_k5",
      "title": "SC-M",
      "maximize": false
    },
    {
      "id": "mis_n100_p0.15",
      "title": "MIS-S",
      "maximize": true
    },
    {
      "id": "mis_n200-300_p0.15",
      "title": "MIS-M",
      "maximize": true
    }
  ],
  "methods": [
    "var_logits_bce",
    "lbp_fce",
    "nmf_fce"
  ],
  "decodings": [
    "EGG",
    "GD"
  ],
  "exclude_series": [
    "var_logits_bce::GD"
  ],
  "series_styles": {
    "var_logits_bce::EGG": {
      "title": "GNN+EGG",
      "color": "GNNEGGColor"
    },
    "lbp_fce::EGG": {
      "title": "LBP+EGG",
      "color": "LBPEGGColor"
    },
    "lbp_fce::GD": {
      "title": "LBP+GD",
      "color": "LBPGDColor"
    },
    "nmf_fce::EGG": {
      "title": "NMF+EGG",
      "color": "NMFEGGColor"
    },
    "nmf_fce::GD": {
      "title": "NMF+GD",
      "color": "NMFGDColor"
    }
  },
  "define_colors": {
  },
  "result_value_key": "solution_value",
  "gap_as_percent": true,
  "clamp_negative_gap": true,
  "strict_missing_opt": true,
  "xlabel": "Fixed-variable proportion",
  "ylabel": "Gap (\\%)",
  "panel_width": "0.42\\textwidth",
  "panel_height": "0.30\\textwidth",
  "horizontal_sep": "0.75cm",
  "vertical_sep": "0.75cm",
  "bar_width": "5.5pt",
  "legend_columns": 3,
  "legend_yshift": "-0.45cm",
  "show_all_y_ticks": true,
  "x_label_digits": 1,
  "ypad": 1.15
}
